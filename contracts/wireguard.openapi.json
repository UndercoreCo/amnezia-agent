        "properties": {
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "external_id": {
            "type": "string",
            "title": "External Id"
          },
          "device_id": {
            "type": "string",
            "title": "Device Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "last_handshake_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Handshake At"
          },
          "connection_checked_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Connection Checked At"
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "external_id",
          "device_id",
          "name",
          "expires_at",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "ClientView"
      },
      "CreateClient": {
        "properties": {
          "external_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "External Id"
          },
          "device_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Device Id"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "expires_at": {
            "type": "string",
            "maxLength": 35,
            "minLength": 20,
            "format": "date-time",
            "title": "Expires At",
            "description": "Required future RFC3339 timestamp with timezone; normalized to UTC milliseconds",
            "examples": [
              "2030-01-01T00:00:00.000Z"
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "external_id",
          "device_id",
          "name",
          "expires_at"
        ],
        "title": "CreateClient"
      },
      "HTTPValidationError": {
        "properties": {
